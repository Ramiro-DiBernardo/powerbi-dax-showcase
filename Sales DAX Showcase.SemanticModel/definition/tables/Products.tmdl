/// Product dimension.
table Products
	lineageTag: 2cb4aa3e-3190-4461-865f-a4ac3c614f12

	column ProductKey
		dataType: int64
		isHidden
		lineageTag: cbce0a90-2bc9-4988-958e-e22294ab94c5
		summarizeBy: none
		sourceColumn: ProductKey

	column Product
		dataType: string
		lineageTag: 8220cd41-1688-47ef-9b85-c26fbfe0abbd
		sourceColumn: Product

	column Category
		dataType: string
		lineageTag: 5c7edcdd-ca41-42f4-b8a3-95e36c62c5c0
		sourceColumn: Category

	column ListPrice
		dataType: double
		lineageTag: 0d29e26a-48c0-4f55-88d0-799d185fe5f5
		sourceColumn: ListPrice

	column UnitCost
		dataType: double
		lineageTag: 5b8764ed-c90b-4ae3-8410-aee7774bfff3
		sourceColumn: UnitCost

	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Products.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ProductKey", Int64.Type}, {"Product", type text}, {"Category", type text}, {"ListPrice", type number}, {"UnitCost", type number}}, "en-US")
				in
				    Typed

